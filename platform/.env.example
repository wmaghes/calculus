# Supabase → Project Settings → API. Both are safe to expose to the browser;
# row-level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public URL of the app, used to build auth redirect links.
# Leave unset locally; set it on Vercel (e.g. https://app.example.com).
NEXT_PUBLIC_SITE_URL=
