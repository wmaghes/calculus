# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://copractice@localhost:5432/copractice
# Local embedding model directory (bge-small-en-v1.5 downloaded once, offline).
EMBED_MODEL_PATH=/models/bge-small-en-v1.5
# "sentence-transformers" (production) or "dev-hash" (tests only; not semantic)
EMBED_BACKEND=sentence-transformers
# Ingest
COURTLISTENER_BULK_BASE=https://com-courtlistener-storage.s3-us-west-2.amazonaws.com
INGEST_SAMPLE_SIZE=1000
# Step 7+ (not used yet): LLM_BACKEND=anthropic-zdr|local ; keys via secret manager, never here in plain text for production
